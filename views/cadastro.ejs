<!DOCTYPE html>
<html lang="pt-br">

<%- include('partials/head', { pageTitle: 'Cadastro | Self Healthy' }) %>

<body>
  <a href="#conteudo-principal" class="skip-link">Pular para o conteúdo principal</a>
  <%- include('partials/navbar', { navLinks, activePage }) %>

  <main class="login-main" id="conteudo-principal" tabindex="-1">
    <section class="login-card" aria-labelledby="titulo-cadastro">
      <h1 id="titulo-cadastro">Criar nova conta</h1>
      <p class="login-subtitle">Crie sua conta para entrar no blog, visualizar seu perfil e usar o Assistente SH.</p>

      <form class="login-form" action="/enviar" method="post" id="cadastro-form" novalidate>
        <label for="nome">Nome completo <span>*</span></label>
        <input id="nome" name="nome" type="text" placeholder="Seu nome completo" autocomplete="name" required aria-describedby="nome-error form-message">
        <p id="nome-error" class="field-error" hidden></p>

        <label for="email">E-mail <span>*</span></label>
        <input id="email" name="email" type="email" placeholder="seuemail@exemplo.com" autocomplete="email" required aria-describedby="email-error form-message">
        <p id="email-error" class="field-error" hidden></p>

        <label for="senha">Senha <span>*</span></label>
        <input id="senha" name="senha" type="password" placeholder="Crie uma senha" autocomplete="new-password" required aria-describedby="senha-error form-message">
        <p id="senha-error" class="field-error" hidden></p>

        <label for="confirmar-senha">Confirmar senha <span>*</span></label>
        <input id="confirmar-senha" name="confirmar_senha" type="password" placeholder="Repita sua senha" autocomplete="new-password" required aria-describedby="confirmar-senha-error form-message">
        <p id="confirmar-senha-error" class="field-error" hidden></p>

        <button type="submit" class="login-button">Cadastrar</button>
        <div id="form-message" class="form-message" role="status" aria-live="polite" aria-atomic="true"></div>
      </form>

      <p class="register-text">Já tem conta? <a href="/login">Fazer login</a></p>

      <p class="conteudo-obrigatorio">Campos obrigatórios marcados com <span>*</span></p>
    </section>
  </main>

  <%- include('partials/footer', { footerActive }) %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/javascript/cadastro.js" defer></script>
</body>

</html>
