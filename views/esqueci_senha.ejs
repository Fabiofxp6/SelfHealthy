<!DOCTYPE html>
<html lang="pt-br">

<%- include('partials/head', { pageTitle: 'Esqueci a senha | Self Healthy' }) %>

<body>
  <a href="#conteudo-principal" class="skip-link">Pular para o conteúdo principal</a>
  <%- include('partials/navbar', { navLinks, activePage }) %>

  <main class="login-main" id="conteudo-principal" tabindex="-1">
    <section class="login-card" aria-labelledby="titulo-esqueci">
      <h1 id="titulo-esqueci">Redefinir senha</h1>
      <p class="login-subtitle">Informe seu e-mail e escolha uma nova senha.</p>

      <form class="login-form" action="/esqueci-senha" method="post" id="esqueci-form" novalidate>
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" placeholder="seuemail@exemplo.com" autocomplete="email" required aria-describedby="email-error esqueci-message">
        <p id="email-error" class="field-error" hidden></p>

        <label for="senha">Nova senha</label>
        <input id="senha" name="senha" type="password" placeholder="Mínimo de 8 caracteres" autocomplete="new-password" required aria-describedby="senha-error esqueci-message">
        <p id="senha-error" class="field-error" hidden></p>

        <label for="confirmar_senha">Confirmar nova senha</label>
        <input id="confirmar_senha" name="confirmar_senha" type="password" placeholder="Repita a nova senha" autocomplete="new-password" required aria-describedby="confirmar-senha-error esqueci-message">
        <p id="confirmar-senha-error" class="field-error" hidden></p>

        <button type="submit" class="login-button">Redefinir senha</button>
        <div id="esqueci-message" class="form-message" role="status" aria-live="polite" aria-atomic="true"></div>
      </form>

      <p class="register-text">Lembrou a senha? <a href="/login">Voltar ao login</a></p>
    </section>
  </main>

  <%- include('partials/footer', { footerActive }) %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/javascript/esqueci_senha.js" defer></script>
</body>

</html>
